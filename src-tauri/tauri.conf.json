{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Buildify",
  "version": "1.0.0",
  "identifier": "com.github.buildnotifier",
  "build": {
    "beforeDevCommand": "npm run dev:ui",
    "beforeBuildCommand": "npm run build:ui",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Buildify",
        "width": 900,
        "height": 760,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "trayIcon": {
      "iconPath": "icons/tray.ico",
      "tooltip": "Buildify"
    },
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.ico", "icons/icon.png"]
  }
}
